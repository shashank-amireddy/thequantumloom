---
import MainLayout from "~/layouts/MainLayout.astro";

import { Separator } from "~/components/ui";

import About from "~/components/links/About.tsx";
import Projects from "~/components/links/Projects.tsx";
// import Stacks from "~/components/Stacks.tsx";
import Socials from "~/components/links/Socials.tsx";
import DevelopedBy from "~/components/links/DevelopedBy.tsx";
---

<MainLayout>
  <main class="container noise p-3 mx-auto max-w-screen-sm min-h-dvh">
    <About client:idle />

    <Separator className="my-8" />

    <Projects client:idle />

    <div class="h-10"></div>

    <Socials client:idle />

    <Separator className="my-8" />

    <DevelopedBy />
  </main>
</MainLayout>

<style>
  :global(body) {
    position: relative; /* Ensure the pseudo-element is positioned relative to the body */
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }

  :global(body)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("/nnnoise.svg");
    background-size: 500px;
    background-repeat: repeat;
    background-attachment: fixed;
    pointer-events: none;
    z-index: -1;
  }

  /* Apply opacity only for Firefox */
  @supports (-moz-appearance: none) {
    :global(body)::before {
      opacity: 0.2;
    }
  }
</style>


